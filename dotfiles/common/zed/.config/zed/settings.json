{
  "git": {
    "diff_base": "head"
  },
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "ui_font_family": ".SystemUIFont",
  "cursor_blink": true,
  "buffer_font_fallbacks": ["FiraCode Nerd Font"],
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "soft_wrap": "editor_width",
  "hard_tabs": false,
  "tab_size": 2,
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "semantic_tokens": "combined",
  "load_direnv": "direct",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 10.0,
  "show_edit_predictions": false,
  "git_panel": {
    "sort_by": "path",
    "tree_view": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Mocha (Blur) [Light]",
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "keyword",
        "token_modifiers": ["todo"],
        "foreground_color": "#FF8C00",
        "background_color": "#2B1700",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["fixme"],
        "foreground_color": "#FF2D55",
        "background_color": "#2B0011",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["hack"],
        "foreground_color": "#FFD60A",
        "background_color": "#272100",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["note"],
        "foreground_color": "#0A84FF",
        "background_color": "#001B2B",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["info"],
        "foreground_color": "#0A84FF",
        "background_color": "#001B2B",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["warn"],
        "foreground_color": "#FF9F0A",
        "background_color": "#271B00",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["warning"],
        "foreground_color": "#FF9F0A",
        "background_color": "#271B00",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["bug"],
        "foreground_color": "#FF453A",
        "background_color": "#2B0A00",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["xxx"],
        "foreground_color": "#BF5AF2",
        "background_color": "#1B0029",
        "font_weight": "bold",
      },
      {
        "token_type": "keyword",
        "token_modifiers": ["deprecated"],
        "foreground_color": "#98989D",
        "background_color": "#1A1A1A",
        "font_weight": "bold",
      },
    ],
  },
}
