{
  "layer": "top",
  "position": "top",
  "output": [
    "DP-1"
  ],
  "height": 0,
  "width": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 5,
  "include": [
    "modules/groups.jsonc",
    "modules/window.jsonc",
    "modules/workspaces.jsonc",
    "modules/audio.jsonc",
    "modules/language.jsonc",
    "modules/clock.jsonc",
    "modules/tray.jsonc",
    "modules/notifications.jsonc",
    "modules/connections.jsonc",
    "modules/tray-notify.jsonc"
  ],
  "modules-left": [
    "wlr/taskbar",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/audio",
    "hyprland/language",
    "group/tray-group",
    "group/connections",
    "clock"
  ],
      "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 25,
        "spacing": 1,
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "ignore-list": [],
        "on-click": "activate"
    }
}